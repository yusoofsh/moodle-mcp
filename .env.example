# External HTTPS origin, no path or trailing /mcp.
PUBLIC_URL=https://moodle-mcp.example.com
PORT=3000
# Exactly one trusted reverse proxy. Keep the container's port bound to loopback.
TRUST_PROXY_HOPS=1

# Local owner password is the default. No GitHub app is needed.
AUTH_MODE=password
# Generate with the image's hidden-prompt helper (see README). Paste the complete
# generated value here. Never put your plaintext password in this file.
AUTH_PASSWORD_HASH=

# Optional legacy GitHub login: set AUTH_MODE=github and uncomment all three.
# Callback: ${PUBLIC_URL}/interaction/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_USER_ID=18055365

# Generate: openssl rand -hex 32. Persist this with the OAuth data volume.
AUTH_SECRET=
OAUTH_DATABASE_PATH=/data/oauth.sqlite

# Moodle base URL including its installation subdirectory, if any.
MOODLE_URL=https://your-school.example/moodle
MOODLE_TOKEN=
MOODLE_MCP_MAX_FILE_MB=10
