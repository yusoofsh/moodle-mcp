# External HTTPS origin, no path or trailing /mcp.
PUBLIC_URL=https://moodle-mcp.example.com
PORT=3000
# Exactly one trusted reverse proxy. Keep the container's port bound to loopback.
TRUST_PROXY_HOPS=1

# GitHub OAuth App; callback: ${PUBLIC_URL}/interaction/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric account ID; this example is yusoofsh. Never replace with a login name.
GITHUB_ALLOWED_USER_ID=18055365
# Generate: openssl rand -hex 32. Persist this with the OAuth data volume.
AUTH_SECRET=
OAUTH_DATABASE_PATH=/data/oauth.sqlite

# Moodle base URL including its installation subdirectory, if any.
MOODLE_URL=https://your-school.example/moodle
MOODLE_TOKEN=
MOODLE_MCP_MAX_FILE_MB=10
