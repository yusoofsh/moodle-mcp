{
  "name": "@yusoofsh/moodle-mcp",
  "version": "0.5.0",
  "description": "Read-only Moodle MCP with password OAuth for Cloudflare Workers Free and OCI",
  "type": "module",
  "bin": {
    "moodle-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/http-server.js",
    "start:stdio": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run test",
    "format": "prettier --write src tests scripts package.json tsconfig.json vitest.config.ts compose.yaml README.md SECURITY.md docs/TRIAGE.md docs/REVIEW.md docs/CLOUDFLARE.md",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json vitest.config.ts compose.yaml README.md SECURITY.md docs/TRIAGE.md docs/REVIEW.md docs/CLOUDFLARE.md",
    "password:hash": "node dist/auth/password-cli.js",
    "workers:build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "workers:dev": "wrangler dev",
    "workers:deploy": "wrangler deploy",
    "workers:test": "node scripts/test-workers.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "oidc-provider": "9.12.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "9.12.1",
    "@types/supertest": "^7.0.0",
    "prettier": "3.9.9",
    "supertest": "^7.2.2",
    "typescript": "^5.9.0",
    "vitest": "5.0.1",
    "wrangler": "4.137.0",
    "@cloudflare/workers-types": "5.20260923.1",
    "miniflare": "5.20260921.0-alpha"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "moodle",
    "mcp",
    "claude",
    "education",
    "lms",
    "obsidian",
    "study"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yusoofsh/moodle-mcp.git"
  },
  "homepage": "https://github.com/yusoofsh/moodle-mcp",
  "bugs": {
    "url": "https://github.com/yusoofsh/moodle-mcp/issues"
  },
  "packageManager": "bun@1.4.2"
}
