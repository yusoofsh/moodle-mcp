{
  "name": "@yusoofsh/moodle-mcp",
  "version": "0.3.0",
  "description": "Read-only Moodle MCP with OAuth, GitHub owner authentication, and OCI deployment",
  "type": "module",
  "bin": {
    "moodle-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/http-server.js",
    "start:stdio": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run test",
    "format": "prettier --write src tests package.json tsconfig.json vitest.config.ts .github/workflows/publish.yml compose.yaml README.md SECURITY.md docs/TRIAGE.md docs/REVIEW.md",
    "format:check": "prettier --check src tests package.json tsconfig.json vitest.config.ts .github/workflows/publish.yml compose.yaml README.md SECURITY.md docs/TRIAGE.md docs/REVIEW.md"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "oidc-provider": "9.12.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "9.12.1",
    "@types/supertest": "^7.0.0",
    "prettier": "3.9.9",
    "supertest": "^7.2.2",
    "typescript": "^5.9.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "moodle",
    "mcp",
    "claude",
    "education",
    "lms",
    "obsidian",
    "study"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yusoofsh/moodle-mcp.git"
  },
  "homepage": "https://github.com/yusoofsh/moodle-mcp",
  "bugs": {
    "url": "https://github.com/yusoofsh/moodle-mcp/issues"
  },
  "packageManager": "bun@1.4.2"
}
