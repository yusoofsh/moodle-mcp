{
  "name": "moodle-mcp",
  "version": "0.3.0",
  "description": "Read-only Moodle MCP with owner-only OAuth for ChatGPT and local stdio",
  "type": "module",
  "bin": {
    "moodle-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "deploy": "wrangler deploy",
    "dev": "npx @modelcontextprotocol/inspector node dist/server.js",
    "test": "bun test --preload ./tests/setup.ts",
    "test:watch": "bun test --watch --preload ./tests/setup.ts",
    "prepublishOnly": "bun run check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check": "bun run typecheck && bun run test && bun run build",
    "bundle:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "format:check": "prettier --check src tests package.json tsconfig*.json docs/CHATGPT-OAUTH.md docs/TRIAGE.md"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@types/bun": "1.4.2",
    "@types/node": "22.19.17",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "keywords": [
    "moodle",
    "mcp",
    "claude",
    "education",
    "lms",
    "obsidian",
    "study"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yusoofsh/moodle-mcp.git"
  },
  "homepage": "https://github.com/yusoofsh/moodle-mcp#readme",
  "bugs": {
    "url": "https://github.com/yusoofsh/moodle-mcp/pulls"
  },
  "packageManager": "bun@1.4.2"
}
